# Link do Cal.com para o diagnóstico gratuito (ex.: ordia/diagnostico)
NEXT_PUBLIC_CALCOM_LINK=ordia/diagnostico

# Endpoint do Formspree para captura de leads (ex.: https://formspree.io/f/xxxxxx)
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-id

# ID de medição do Google Analytics 4 (ex.: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Caminho base para o GitHub Pages (definido automaticamente no Action)
NEXT_PUBLIC_BASE_PATH=
